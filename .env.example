# LiveStop configuration. Copy to `.env` and adjust:
#   Copy-Item .env.example .env
# docker compose reads `.env` automatically. Never commit `.env`.
# Comments must be on their own line (no inline comments after values).

# ---------------------------------------------------------------------------
# Database (db container)
# ---------------------------------------------------------------------------
LIVESTOP_DB_USER=livestop
LIVESTOP_DB_PASSWORD=livestop
LIVESTOP_DB_NAME=livestop
# Host port for Postgres, bound to 127.0.0.1 only. Change if 5432 is taken.
LIVESTOP_DB_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Backend: process
# Inside Docker Compose, DATABASE_URL / HTTP_ADDR / METRICS_ADDR are set by
# docker-compose.yml. The values here are for running the backend on the host.
# ---------------------------------------------------------------------------
LIVESTOP_DATABASE_URL=postgres://livestop:livestop@localhost:5432/livestop?sslmode=disable
LIVESTOP_HTTP_ADDR=:8080
LIVESTOP_METRICS_ADDR=:9090
# debug | info | warn | error
LIVESTOP_LOG_LEVEL=info
# true enables dev-only features, e.g. POST /internal/import. Never true on a server.
LIVESTOP_DEV=false

# ---------------------------------------------------------------------------
# Transit: static GTFS (daily import)
# ---------------------------------------------------------------------------
# Official VBB GTFS link (pole-precise, matches GTFS-RT trip ids, updated ~2x/week). No ETag: change detection uses SHA-256.
LIVESTOP_GTFS_URL=https://unternehmen.vbb.de/gtfs
# Daily import time, HH:MM in Europe/Berlin.
LIVESTOP_GTFS_IMPORT_TIME=03:30
# Scope filter: minLon,minLat,maxLon,maxLat (default: Berlin).
LIVESTOP_SCOPE_BBOX=13.088,52.338,13.761,52.675

# ---------------------------------------------------------------------------
# Transit: GTFS-RT (realtime poller)
# ---------------------------------------------------------------------------
LIVESTOP_GTFSRT_URL=https://production.gtfsrt.vbb.de/data
# Go duration. VBB allows max 7 requests/minute (since 2026-11-02); config validation enforces a 10s floor.
LIVESTOP_GTFSRT_POLL_INTERVAL=15s
