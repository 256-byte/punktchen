# punktchen configuration. Copy to `.env` and adjust:
#   Copy-Item .env.example .env
# docker compose reads `.env` automatically. Never commit `.env`.
# Comments must be on their own line (no inline comments after values).

# ---------------------------------------------------------------------------
# Database (db container)
# ---------------------------------------------------------------------------
PUNKTCHEN_DB_USER=punktchen
PUNKTCHEN_DB_PASSWORD=punktchen
PUNKTCHEN_DB_NAME=punktchen
# Host port for Postgres, bound to 127.0.0.1 only. Change if 5432 is taken.
PUNKTCHEN_DB_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Backend: process
# Inside Docker Compose, DATABASE_URL / HTTP_ADDR / METRICS_ADDR are set by
# docker-compose.yml. The values here are for running the backend on the host.
# ---------------------------------------------------------------------------
PUNKTCHEN_DATABASE_URL=postgres://punktchen:punktchen@localhost:5432/punktchen?sslmode=disable
PUNKTCHEN_HTTP_ADDR=:8080
PUNKTCHEN_METRICS_ADDR=:9090
# debug | info | warn | error
PUNKTCHEN_LOG_LEVEL=info
# true enables dev-only features, e.g. POST /internal/import. Never true on a server.
PUNKTCHEN_DEV=false

# ---------------------------------------------------------------------------
# Transit: static GTFS (daily import)
# ---------------------------------------------------------------------------
# Official VBB GTFS link (pole-precise, matches GTFS-RT trip ids, updated ~2x/week). No ETag: change detection uses SHA-256.
PUNKTCHEN_GTFS_URL=https://unternehmen.vbb.de/gtfs
# Daily import time, HH:MM in Europe/Berlin.
PUNKTCHEN_GTFS_IMPORT_TIME=03:30
# Scope filter: minLon,minLat,maxLon,maxLat (default: Berlin).
PUNKTCHEN_SCOPE_BBOX=13.088,52.338,13.761,52.675

# ---------------------------------------------------------------------------
# Amenities: public toilets and drinking fountains (Geoportal Berlin WFS, daily import, ADR-0010)
# ---------------------------------------------------------------------------
# Override only to test against another server; defaults are the Geoportal Berlin WFS.
# PUNKTCHEN_TOILETS_URL=
# PUNKTCHEN_FOUNTAINS_URL=
# Daily import time, HH:MM in Europe/Berlin.
PUNKTCHEN_AMENITIES_IMPORT_TIME=04:15

# ---------------------------------------------------------------------------
# Transit: GTFS-RT (realtime poller)
# ---------------------------------------------------------------------------
PUNKTCHEN_GTFSRT_URL=https://production.gtfsrt.vbb.de/data
# Go duration. VBB allows max 7 requests/minute (since 2026-11-02); config validation enforces a 10s floor.
PUNKTCHEN_GTFSRT_POLL_INTERVAL=15s
