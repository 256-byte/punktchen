# --- Secrets / local config ------------------------------------------------
.env
.env.*
!.env.example

# --- Downloaded data (never commit, see CLAUDE.md rule 11) -----------------
# GTFS zips, extracted CSVs, GTFS-RT dumps, DB dumps.
/data/
/backend/data/
/pgdata/
*.zip
*.dump
*.sql.gz
*.pb
# Small recorded fixtures for tests are allowed (< 5 MB each).
!/backend/testdata/**

# --- Go --------------------------------------------------------------------
/backend/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/backend/coverage*
/backend/tmp/

# --- Node / Expo -----------------------------------------------------------
node_modules/
/mobile/.expo/
/mobile/dist/
/mobile/web-build/
/mobile/coverage/
/mobile/expo-env.d.ts
# Native projects are generated by `expo prebuild` (continuous native generation).
/mobile/ios/
/mobile/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editors / OS ----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code (personal settings only) ----------------------------------
.claude/settings.local.json
