{
  "expo": {
    "name": "LiveStop",
    "slug": "livestop",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "livestop",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LiveStop shows live departures at the stops around you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
